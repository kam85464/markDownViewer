{
  "name": "markdown-viewer-pro",
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "description": "A powerful Markdown viewer built with Electron and React.",
  "author": "Kamalsoft",
  "keywords": [
    "markdown",
    "viewer",
    "editor",
    "electron",
    "react",
    "vite"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node generate-sitemap.js && node secure-offline.js && tsc && vite build && electron-builder",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "clsx": "^2.1.0",
    "electron-store": "^8.2.0",
    "highlight.js": "^11.9.0",
    "html-to-image": "^1.11.11",
    "jotai": "^2.6.4",
    "katex": "^0.16.9",
    "lucide-react": "^0.330.0",
    "markdown-it": "^14.0.0",
    "markdown-it-highlightjs": "^4.0.1",
    "markdown-it-katex": "^2.0.3",
    "markdown-it-task-lists": "^2.1.1",
    "marked": "^17.0.2",
    "mermaid": "^10.8.0",
    "monaco-editor": "^0.45.0",
    "monaco-vim": "^0.4.1",
    "plantuml-encoder": "^1.4.0",
    "prettier": "^3.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reveal.js": "^5.0.4",
    "tailwind-merge": "^2.2.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.10",
    "@types/markdown-it": "^13.0.7",
    "@types/marked": "^5.0.2",
    "@types/node": "^22.0.0",
    "@types/plantuml-encoder": "^1.4.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/reveal.js": "^5.0.1",
    "@vitejs/plugin-react-swc": "^3.7.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^32.0.0",
    "electron-builder": "^24.9.1",
    "postcss": "^8.4.49",
    "rollup-plugin-visualizer": "^6.0.5",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-pwa": "^0.21.1",
    "wait-on": "^8.0.0"
  },
  "build": {
    "appId": "com.markdownviewer.app",
    "productName": "Markdown Viewer Pro",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "assets"
    },
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": "AppImage"
    }
  }
}
